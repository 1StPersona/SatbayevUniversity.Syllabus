{
  "ConnectionStrings": {
    "Default": "Server=localhost,1433;Database=SatbayevSyllabus;User Id=sa;Password=CHANGE_ME;TrustServerCertificate=True;MultipleActiveResultSets=True"
  },
  "Jwt": {
    "Issuer": "SatbayevUniversity.Syllabus",
    "Audience": "SatbayevUniversity.Syllabus.Web.Client",
    "SigningKey": "",
    "LifetimeMinutes": 480
  },
  "Cors": {
    "Origins": [
      "http://localhost:4200"
    ]
  },
  "Umkd": {
    "StoragePath": "App_Data/umkd",
    "MaxFileSizeBytes": 52428800
  },
  "Database": {
    "MigrateOnStartup": true
  },
  "Seed": {
    "AdminEmail": "admin@esyllabus.local",
    "AdminPassword": "",
    "DemoData": false
  },
  "Swagger": {
    "Enabled": false
  },
  "AllowedHosts": "*",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning",
        "Microsoft.AspNetCore.Diagnostics.ExceptionHandlerMiddleware": "Fatal"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/syllabus-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "fileSizeLimitBytes": 52428800,
          "rollOnFileSizeLimit": true,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext} {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ]
  },
  "RateLimit": {
    "LoginPerMinute": 20
  }
}